# AWS
AWS_REGION=us-east-1

# Circuit breakers
AI_ENABLED=true
AGENT_INVOCATION_ENABLED=true
RAG_ENABLED=true
REMEDIATION_ENABLED=true

# Cost target (design goal, not a billing guarantee)
TARGET_MONTHLY_COST_USD=5.00

# Application quotas (dev)
MAX_INCIDENTS_PER_DAY=10
MAX_AGENT_RUNS_PER_INCIDENT=2
MAX_AGENT_TURNS=4
MAX_TOOL_CALLS_PER_RUN=8
MAX_RAG_CALLS_PER_RUN=2
MAX_RAG_RESULTS=4
MAX_LOG_WINDOW_MINUTES=15
MAX_LOG_RESULTS=100
MAX_METRIC_WINDOW_MINUTES=60
MAX_SESSION_SECONDS=120
MAX_MODEL_INPUT_TOKENS_PER_CALL=6000
MAX_MODEL_OUTPUT_TOKENS_PER_CALL=1200
LOG_RETENTION_DAYS=7
EVAL_SAMPLE_RATE=0.10

# Local API (use dynamodb after terraform apply)
INCIDENT_REPOSITORY=memory
INCIDENTS_TABLE_NAME=ai-incident-copilot-dev-incidents
DEPLOYMENTS_TABLE_NAME=ai-incident-copilot-dev-deployments
CORS_ORIGINS=http://localhost:3000

# Event ingest. Leave EVENT_BUS_NAME empty to skip EventBridge fan-out (local shortcut).
EVENT_BUS_NAME=
EVENT_SOURCE=ai-incident-copilot.incidents
