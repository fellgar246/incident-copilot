{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-incident-copilot.local/tools/query_logs.input.json",
  "title": "query_logs",
  "type": "object",
  "additionalProperties": false,
  "required": ["service", "start_minutes_ago"],
  "properties": {
    "service": {
      "type": "string",
      "enum": ["payments-api", "orders-api", "notifications-worker"]
    },
    "start_minutes_ago": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "level": {
      "type": "string",
      "enum": ["DEBUG", "INFO", "WARN", "ERROR"]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 50
    }
  }
}
