{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-incident-copilot.local/tools/query_logs.output.json",
  "title": "query_logs_result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "tool_class",
    "requires_approval",
    "service",
    "log_group",
    "window_minutes",
    "redacted",
    "truncated",
    "untrusted",
    "items"
  ],
  "properties": {
    "tool": { "const": "query_logs" },
    "tool_class": { "const": "READ_ONLY" },
    "requires_approval": { "const": false },
    "service": { "type": "string" },
    "log_group": { "type": "string" },
    "window_minutes": { "type": "integer", "minimum": 1 },
    "redacted": { "type": "boolean" },
    "truncated": { "type": "boolean" },
    "untrusted": { "const": true },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "level", "message", "fields"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "level": { "type": "string" },
          "message": { "type": "string" },
          "fields": { "type": "object" }
        }
      }
    }
  }
}
