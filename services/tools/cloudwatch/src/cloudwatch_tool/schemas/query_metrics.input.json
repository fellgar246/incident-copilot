{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-incident-copilot.local/tools/query_metrics.input.json",
  "title": "query_metrics",
  "type": "object",
  "additionalProperties": false,
  "required": ["service", "metric", "start_minutes_ago"],
  "properties": {
    "service": {
      "type": "string",
      "enum": ["payments-api", "orders-api", "notifications-worker"]
    },
    "metric": {
      "type": "string",
      "enum": [
        "error_rate",
        "request_count",
        "latency_p95",
        "throttles",
        "duration",
        "custom_health"
      ]
    },
    "start_minutes_ago": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    }
  }
}
