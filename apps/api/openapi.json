          "404": {
            "description": "incident not found"
          },
          "409": {
            "description": "A remediation is already active, or the incident is not approved."
          },
          "504": {
            "description": "The safe write exceeded its timeout and the incident is FAILED."
          },
          "422": {
            "description": "Validation Error",
