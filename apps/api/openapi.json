  "components": {
    "schemas": {
      "AgentRunRecord": {
        "properties": {
          "agent_run_id": {
            "type": "string",
            "title": "Agent Run Id"
          },
          "incident_id": {
            "type": "string",
            "title": "Incident Id"
          },
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id"
          },
          "status": {
            "$ref": "#/components/schemas/AgentRunStatus"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "model_calls": {
            "type": "integer",
            "title": "Model Calls",
            "default": 0
          },
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens",
            "default": 0
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens",
            "default": 0
          },
          "tool_calls": {
            "type": "integer",
            "title": "Tool Calls",
            "default": 0
          },
          "rag_calls": {
            "type": "integer",
            "title": "Rag Calls",
            "default": 0
          },
          "runtime_ms": {
            "type": "integer",
            "title": "Runtime Ms",
            "default": 0
          },
          "estimated_cost_usd": {
            "type": "number",
            "title": "Estimated Cost Usd",
            "default": 0.0
