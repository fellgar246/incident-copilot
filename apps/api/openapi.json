        "summary": "Remediate Incident",
        "operationId": "remediate_incident_incidents__id__remediate_post",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
