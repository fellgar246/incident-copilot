            "title": "Stop Reason"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "tool_names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tool Names"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agent_run_id",
          "incident_id",
          "correlation_id",
          "status",
          "model",
          "created_at",
          "updated_at"
