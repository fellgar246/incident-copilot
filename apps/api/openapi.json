            "type": "string",
            "title": "Approval Id"
          },
          "incident_id": {
            "type": "string",
            "title": "Incident Id"
          },
          "status": {
            "$ref": "#/components/schemas/ApprovalStatus"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "decided_at": {
