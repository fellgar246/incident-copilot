    "/incidents/{id}/agent-runs": {
      "get": {
        "summary": "List Agent Runs",
        "operationId": "list_agent_runs_incidents__id__agent_runs_get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "501": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
