        "type": "string",
        "enum": [
          "QUEUED",
          "INVESTIGATING",
          "DIAGNOSED",
          "FAILED",
          "STOPPED"
        ],
        "title": "AgentRunStatus"
      },
      "AgentRunsResponse": {
        "properties": {
          "runs": {
            "items": {
              "$ref": "#/components/schemas/AgentRunRecord"
            },
            "type": "array",
            "title": "Runs"
          },
          "trace": {
            "additionalProperties": true,
            "type": "object",
            "title": "Trace"
          },
          "EstimatedCostPerIncident": {
            "type": "number",
            "title": "Estimatedcostperincident"
          },
          "TokensPerIncident": {
            "type": "integer",
            "title": "Tokensperincident"
          },
          "ToolCallsPerIncident": {
            "type": "integer",
            "title": "Toolcallsperincident"
          },
          "RuntimePerIncident": {
            "type": "integer",
            "title": "Runtimeperincident"
          },
          "RagCallsPerIncident": {
            "type": "integer",
            "title": "Ragcallsperincident"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
