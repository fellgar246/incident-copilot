{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-incident-copilot.local/tools/search_runbooks.output.v1.json",
  "title": "search_runbooks_result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "tool_class",
    "requires_approval",
    "query",
    "service",
    "top_k",
    "redacted",
    "truncated",
    "untrusted",
    "hits"
  ],
  "properties": {
    "tool": { "const": "search_runbooks" },
    "tool_class": { "const": "READ_ONLY" },
    "requires_approval": { "const": false },
    "query": { "type": "string" },
    "service": { "type": "string" },
    "top_k": { "type": "integer", "minimum": 1, "maximum": 4 },
    "redacted": { "type": "boolean" },
    "truncated": { "type": "boolean" },
    "untrusted": { "const": true },
    "hits": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "score", "snippet", "metadata"],
        "properties": {
          "document_id": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0 },
          "snippet": { "type": "string" },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service", "document_type"],
            "properties": {
              "service": { "type": "string" },
              "document_type": { "type": "string" },
              "severity": { "type": "string" },
              "version": { "type": "string" },
              "updated_at": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
